# ─── Banco de dados ────────────────────────────────────────────────
# Em desenvolvimento local (Postgres rodando via docker compose):
DATABASE_URL="postgresql://oceanflow:oceanflow@localhost:5432/oceanflow?schema=public"

# Dentro da rede do docker compose o host é o nome do serviço "db":
# DATABASE_URL="postgresql://oceanflow:oceanflow@db:5432/oceanflow?schema=public"

# ─── Autenticação (Auth.js — usado a partir da Fase 1) ─────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor"
AUTH_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────────
NODE_ENV="development"

# ─── Rate limit da API pública (/api/v1 e /api/mcp) ────────────────
# Requisições por janela, por token (0 desliga). Janela em segundos.
API_RATE_LIMIT="120"
API_RATE_WINDOW_SECONDS="60"

# ─── Anexos ────────────────────────────────────────────────────────
# Diretório onde os arquivos anexados são gravados.
# Dev: pasta local "uploads". Produção (Docker): volume em /data/uploads.
UPLOAD_DIR="./uploads"
